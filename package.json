{
    "name": "dicom-viewer-desktop",
    "version": "2.0.0",
    "description": "Hospital DICOM Viewer Pro - Desktop Edition",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "pack": "electron-builder --dir"
    },
    "author": "Hospital DICOM Team",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.hospital.dicom-viewer",
        "productName": "DICOM Viewer Pro",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "splash.html",
            "www/**/*",
            "php/**/*"
        ],
        "extraResources": [
            {
                "from": "php",
                "to": "php",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "icon.ico",
            "uninstallerIcon": "icon.ico",
            "installerHeaderIcon": "icon.ico"
        }
    }
}